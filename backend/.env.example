APP_ENV=development
PORT=8080
DB_DSN=root:torikal@tcp(127.0.0.1:3306)/gitlearn?parseTime=true&multiStatements=true&charset=utf8mb4
JWT_SECRET=gitlearn-development-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

# Optional: GitHub OAuth login. Create a GitHub OAuth App and set the
# callback URL to GITHUB_REDIRECT_URL (default shown below).
FRONTEND_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback

# Optional: creates/promotes the CMS admin account when running `go run ./cmd/seed`.
# Leave empty to skip. Set a strong password before enabling.
ADMIN_EMAIL=
ADMIN_PASSWORD=
